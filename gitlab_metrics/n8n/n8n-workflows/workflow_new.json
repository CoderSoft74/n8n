    {
      "id": "create-relations",
      "name": "Create User-Project Relations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1008, 400],
      "parameters": {
        "jsCode": "const relations = [];\n\nconst accessLevelMap = {\n  10: 'Guest',\n  20: 'Reporter',\n  30: 'Developer',\n  40: 'Maintainer',\n  50: 'Owner'\n};\n\nlet projectsProcessed = 0;\nlet totalMembers = 0;\n\nfor (const item of items) {\n  projectsProcessed++;\n  \n  const project = item.context?.project || item.json.project || {};\n  const members = Array.isArray(item.json) ? item.json : [];\n  \n  totalMembers += members.length;\n  \n  for (const member of members) {\n    if (!member.id || !project.gitlab_id) {\n      console.warn('Miembro o proyecto sin ID:', { member, project });\n      continue;\n    }\n    \n    const accessLevel = member.access_level || 30;\n    const role = accessLevelMap[accessLevel] || 'Unknown';\n    const membershipType = accessLevel >= 40 ? 'owner' : 'collaborator';\n    \n    relations.push({\n      json: {\n        user_gitlab_id: member.id,\n        project_gitlab_id: project.gitlab_id,\n        username: member.username,\n        user_name: member.name,\n        project_name: project.name,\n        project_path_with_namespace: project.path_with_namespace || project.name,\n        access_level: accessLevel,\n        user_role: role,\n        membership_type: membershipType,\n        notification_level: member.notification_level || 3,\n        expires_at: member.expires_at || null,\n        created_at_gitlab: member.created_at || new Date().toISOString(),\n        last_activity_at: project.last_activity_at || new Date().toISOString(),\n        is_direct_member: true,\n        sync_timestamp: new Date().toISOString(),\n        _debug: false\n      }\n    });\n  }\n}\n\nconsole.log(`\\n=== RESUMEN DE RELACIONES ===\\nProyectos procesados: ${projectsProcessed}\\nMiembros totales: ${totalMembers}\\nRelaciones creadas: ${relations.length}\\n`);\n\nreturn relations;"
      }
    },
