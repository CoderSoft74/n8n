    {
      "id": "prepare-commits-request",
      "name": "Prepare Commits Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [464, 600],
      "parameters": {
        "jsCode": "const commitRequests = [];\n\nconst cutoffDate = new Date();\ncutoffDate.setDate(cutoffDate.getDate() - 90);\n\nlet activeProjects = 0;\nlet inactiveProjects = 0;\n\nfor (const item of items) {\n  const project = item.json;\n  \n  const lastActivity = project.last_activity_at ? new Date(project.last_activity_at) : null;\n  const isActive = lastActivity && lastActivity > cutoffDate;\n  \n  if (isActive) {\n    activeProjects++;\n    \n    const endDate = new Date();\n    const startDate = new Date();\n    startDate.setDate(startDate.getDate() - 30);\n    \n    commitRequests.push({\n      json: {\n        projectId: project.gitlab_id,\n        projectName: project.name,\n        since: startDate.toISOString().split('T')[0],\n        until: endDate.toISOString().split('T')[0],\n        per_page: 100,\n        with_stats: true,\n        project_data: {\n          name: project.name,\n          path_with_namespace: project.path_with_namespace,\n          last_activity_at: project.last_activity_at\n        },\n        _request_timestamp: new Date().toISOString(),\n        _days_back: 30\n      }\n    });\n  } else {\n    inactiveProjects++;\n  }\n}\n\nconsole.log(`\\n=== SOLICITUDES DE COMMITS ===\\nProyectos totales: ${items.length}\\nProyectos activos (últimos 90 días): ${activeProjects}\\nProyectos inactivos: ${inactiveProjects}\\nSolicitudes generadas: ${commitRequests.length}\\n`);\n\nreturn commitRequests;"
      }
    },
