    {
      "id": "filter-bots",
      "name": "Filter Bots and Service Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [688, 16],
      "parameters": {
        "jsCode": "const filteredUsers = [];\n\nconst botPatterns = [\n  /_bot_/i,\n  /^bot-/i,\n  /-bot$/i,\n  /^gitlab-/i,\n  /-token$/i,\n  /token-/i,\n  /^project_\\d+_bot_/,\n  /^group_\\d+_bot_/\n];\n\nconst serviceUsernames = [\n  'ghost',\n  'root',\n  'alert-bot',\n  'support-bot',\n  'sonarqube',\n  'gitlab-support'\n];\n\nconst serviceNameKeywords = [\n  'token',\n  'bot',\n  'service account',\n  'service',\n  'CI/CD',\n  'GitLab',\n  'Alert',\n  'Support',\n  'SonarQube',\n  'API'\n];\n\nfor (const item of items) {\n  const user = item.json;\n  \n  const isBotUsername = botPatterns.some(pattern => pattern.test(user.username)) ||\n                       serviceUsernames.includes(user.username);\n  \n  const isBotName = serviceNameKeywords.some(keyword => \n    user.name && user.name.toLowerCase().includes(keyword.toLowerCase())\n  );\n  \n  const isBotEmail = user.email && (\n    user.email.includes('noreply') ||\n    user.email.includes('no-reply') ||\n    user.email.includes('bot@') ||\n    user.email.includes('service@')\n  );\n  \n  const isRealUser = !isBotUsername && !isBotName && !isBotEmail;\n  \n  if (isRealUser) {\n    filteredUsers.push({\n      json: {\n        ...user,\n        is_bot: false\n      }\n    });\n  } else {\n    console.log(`Filtrado bot/service: ${user.username} (${user.name})`);\n  }\n}\n\nconsole.log(`Usuarios totales: ${items.length}, Usuarios reales: ${filteredUsers.length}`);\nreturn filteredUsers;"
      }
    },
