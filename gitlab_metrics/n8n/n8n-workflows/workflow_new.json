    {
      "id": "process-projects",
      "name": "Process Projects Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [704, 200],
      "parameters": {
        "jsCode": "const processedProjects = [];\n\nfor (const item of items) {\n  const project = item.json;\n  \n  const namespace = project.namespace || {};\n  const owner = project.owner || {};\n  \n  processedProjects.push({\n    json: {\n      gitlab_id: project.id,\n      name: project.name,\n      name_with_namespace: project.name_with_namespace,\n      description: project.description || '',\n      path: project.path,\n      path_with_namespace: project.path_with_namespace,\n      web_url: project.web_url,\n      ssh_url: project.ssh_url_to_repo,\n      http_url: project.http_url_to_repo,\n      default_branch: project.default_branch || 'main',\n      visibility: project.visibility,\n      owner_id: owner.id || null,\n      namespace_id: namespace.id || null,\n      namespace_name: namespace.name || null,\n      last_activity_at: project.last_activity_at,\n      created_at_gitlab: project.created_at,\n      updated_at_gitlab: project.updated_at,\n      archived: project.archived || false,\n      forks_count: project.forks_count || 0,\n      star_count: project.star_count || 0,\n      open_issues_count: project.open_issues_count || 0,\n      creator_id: project.creator_id || null,\n      commit_count: project.statistics?.commit_count || 0,\n      storage_size: project.statistics?.storage_size || 0,\n      repository_size: project.statistics?.repository_size || 0,\n      processed_at: new Date().toISOString(),\n      _debug: false\n    }\n  });\n}\n\nconsole.log(`Procesados ${processedProjects.length} proyectos`);\nreturn processedProjects;"
      }
    },
